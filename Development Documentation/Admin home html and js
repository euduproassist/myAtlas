ALTER TABLE pre_approved_admins ENABLE ROW LEVEL SECURITY;
ALTER TABLE pre_approved_academic_heads ENABLE ROW LEVEL SECURITY;
ALTER TABLE pre_approved_system_admins ENABLE ROW LEVEL SECURITY;

