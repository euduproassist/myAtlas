-- 1. RPC function to verify pre-approved admin
CREATE OR REPLACE FUNCTION verify_pre_approved_admin(
    p_email VARCHAR,
    p_temppass VARCHAR,
    p_initials VARCHAR,
    p_firstname VARCHAR,
    p_surname VARCHAR,
    p_phone VARCHAR
)
RETURNS BOOLEAN
SECURITY DEFINER
SET search_path = public
LANGUAGE plpgsql
AS $$
BEGIN
    RETURN EXISTS (
        SELECT 1 FROM pre_approved_admins
        WHERE email = p_email
          AND temppass = p_temppass
          AND initials = p_initials
          AND firstname = p_firstname
          AND surname = p_surname
          AND phone = p_phone
    );
END;
$$;

