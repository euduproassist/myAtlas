SELECT public.generate_random_personnel_number() AS test_number;



CREATE OR REPLACE FUNCTION public.generate_random_personnel_number()
RETURNS TEXT
LANGUAGE plpgsql
AS $$
DECLARE
    new_number TEXT;
BEGIN
    PERFORM pg_advisory_xact_lock(731942);

    LOOP
        new_number :=
            (
                (
                    'x' || SUBSTRING(
                        REPLACE(gen_random_uuid()::TEXT, '-', ''),
                        1,
                        15
                    )
                )::BIT(60)::BIGINT
                % 9000000000
                + 1000000000
            )::TEXT;

        EXIT WHEN NOT EXISTS (
            SELECT 1
            FROM public.authorised_personnel
            WHERE personnel_number = new_number
        );
    END LOOP;

    RETURN new_number;
END;
$$;
