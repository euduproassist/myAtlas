
CREATE OR REPLACE FUNCTION public.create_authorised_personnel(
    p_initials TEXT,
    p_first_name TEXT,
    p_surname TEXT,
    p_email_address TEXT,
    p_phone_number TEXT,
    p_role TEXT,
    p_temporary_password TEXT
)
RETURNS UUID
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = pg_catalog, public, extensions
AS $$
DECLARE
    new_personnel_id UUID;
BEGIN
    IF NULLIF(TRIM(p_initials), '') IS NULL
       OR NULLIF(TRIM(p_first_name), '') IS NULL
       OR NULLIF(TRIM(p_surname), '') IS NULL
       OR NULLIF(TRIM(p_email_address), '') IS NULL
       OR NULLIF(TRIM(p_phone_number), '') IS NULL
       OR NULLIF(TRIM(p_temporary_password), '') IS NULL THEN
        RAISE EXCEPTION 'All required fields must be completed.';
    END IF;

    INSERT INTO public.authorised_personnel (
        initials,
        first_name,
        surname,
        email_address,
        phone_number,
        role,
        temporary_password_hash
    )
    VALUES (
        TRIM(p_initials),
        TRIM(p_first_name),
        TRIM(p_surname),
        LOWER(TRIM(p_email_address)),
        TRIM(p_phone_number),
        p_role,
        extensions.crypt(
            p_temporary_password,
            extensions.gen_salt('bf', 12)
        )
    )
    RETURNING id INTO new_personnel_id;

    RETURN new_personnel_id;
END;
$$;

REVOKE ALL ON FUNCTION public.create_authorised_personnel(
    TEXT, TEXT, TEXT, TEXT, TEXT, TEXT, TEXT
) FROM PUBLIC, anon, authenticated;

GRANT EXECUTE ON FUNCTION public.create_authorised_personnel(
    TEXT, TEXT, TEXT, TEXT, TEXT, TEXT, TEXT
) TO service_role;
