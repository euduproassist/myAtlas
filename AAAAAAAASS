-- 1. Enable Row Level Security on both tables
ALTER TABLE public.pre_approved_personnel ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.personnel ENABLE ROW LEVEL SECURITY;

-- 2. Allow public/anonymous lookup on pre_approved_personnel during activation verification
CREATE POLICY "Allow public lookup for activation" 
ON public.pre_approved_personnel 
FOR SELECT 
USING (true);

-- 3. Allow newly authenticated users to insert their own profile during activation
CREATE POLICY "Allow authenticated user insert own profile" 
ON public.personnel 
FOR INSERT 
WITH CHECK (auth.uid() = id);

-- 4. Allow authenticated users to read their own profile during sign-in verification
CREATE POLICY "Allow authenticated user read own profile" 
ON public.personnel 
FOR SELECT 
USING (auth.uid() = id);
