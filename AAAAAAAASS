-- Step 3: Enable Row Level Security (RLS) and configure access policies

-- 1. Enable RLS on pre_approved_personnel table
ALTER TABLE public.pre_approved_personnel ENABLE ROW LEVEL SECURITY;

-- Allow public/anon access to query the whitelist during activation check
CREATE POLICY "Enable read access for public on pre_approved_personnel"
ON public.pre_approved_personnel
FOR SELECT
TO public
USING (true);


-- 2. Enable RLS on personnel table
ALTER TABLE public.personnel ENABLE ROW LEVEL SECURITY;

-- Allow public/anon access to insert new personnel profiles during activation
CREATE POLICY "Enable insert access for public on personnel"
ON public.personnel
FOR INSERT
TO public
WITH CHECK (true);

-- Allow public/anon access to read personnel profiles during sign-in verification
CREATE POLICY "Enable read access for public on personnel"
ON public.personnel
FOR SELECT
TO public
USING (true);

-- Allow public/anon access to update personnel profiles if needed
CREATE POLICY "Enable update access for public on personnel"
ON public.personnel
FOR UPDATE
TO public
USING (true);
