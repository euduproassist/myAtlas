    outline: none;
    font-size: 12px;
    cursor: pointer;
  }
  .behaviour {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 21px;
    padding: 3px 12px;
    border-radius: 14px;
    background: #e8f4ff;
    color: #3185e0;
    font-size: 11px;
    white-space: nowrap;
  }
  .behaviour.conditional {
    background: #d7f8f3;
    color: #00a6b4;
  }
  .behaviour-group {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .behaviour-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border: 0;
    border-radius: 50%;
    background: #d7f8f3;
    color: #00a5b7;
    font-size: 14px;
    line-height: 1;
  }

  .actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    width: 100%;
    margin-top: 26px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 24px;
    border: 1px solid #087cff;
    border-radius: 6px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }
  .btn-cancel {
    min-width: 112px;
    color: #006dff;
    background: #fff;
  }
  .btn-next {
    min-width: 194px;
    color: #fff;
    background: #087cff;
    box-shadow: 0 2px 5px rgba(0, 100, 255, 0.12);
  }
  .btn-previous {
    color: #006dff;
    background: #fff;
    min-width: 140px;
  }
  .btn span {
    margin-left: 7px;
    font-size: 17px;
  }

  /* FOOTER */
  .footer {
    width: 100%;
    max-width: 100%;
    border-top: 1px solid var(--line);
    background: #ffffff;
    padding: 24px 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
  }
  .footer-left {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 0 0 auto;
    font-size: 13px;
    color: #708aa8;
    font-weight: 500;
  }
  .footer-right {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .footer-right a {
    font-size: 13px;
    color: #708aa8;
    font-weight: 500;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .shell { display: flex; flex-direction: column; }
    .welcome { border-right: none; border-bottom: 1px solid var(--line); }
    .grid-2x2 { grid-template-columns: 1fr; }
    .topbar { padding: 0 18px; }
    .footer { padding: 20px 18px; flex-direction: column; gap: 16px; align-items: flex-start; }
    .footer-right { gap: 20px; flex-wrap: wrap; }
    .fields-grid { grid-template-columns: minmax(0, 1fr); column-gap: 18px; row-gap: 32px; padding: 0 3px; }
    .automatic-section { grid-template-columns: minmax(0, 1fr); gap: 22px; margin-top: 28px; padding: 22px 0 0; border-top: 1px solid #d5e9ff; }
    .separator { display: none; }
  }

  @media (max-width: 560px) {
    .topbar { padding: 0 14px; height: 64px; }
    .search { width: 36px; height: 36px; padding: 0; justify-content: center; border: none; background: #f5f9fd; box-shadow: none; }
    .search input { display: none; }
    .search svg { margin: 0; }
  }
</style>
</head>

<body>
<div class="page">
  <!-- TOP BAR -->
  <header class="topbar">
    <div class="brand">
      <a href="#" aria-label="myAtlas home" class="logo-link" onclick="return false;">
        <img class="brand-logo" src="assets/logos.png" alt="myAtlas College">
      </a>
    </div>

    <div class="top-right">
      <label class="search" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="10.7" cy="10.7" r="6.7"></circle>
          <path d="M16 16l5 5"></path>
        </svg>
        <input type="search" placeholder="Search applications, cycles, students..." />
      </label>
      <div class="help" aria-label="Help">?</div>

      <!-- User Profile Menu Wrapper -->
      <div class="user-menu-wrapper" id="userMenuTrigger">
        <div class="avatar" id="userAvatar">--</div>
        <div class="chevron" aria-hidden="true"></div>

        <!-- Dropdown Menu -->
        <div class="user-dropdown-menu" id="userDropdownMenu">
          <div class="dropdown-user-info">
            <div class="dropdown-user-name" id="dropdownUserName">Loading...</div>
            <div class="dropdown-user-email" id="dropdownUserEmail">---</div>
            <span class="dropdown-user-role" id="dropdownUserRole">---</span>
          </div>
          <button type="button" class="dropdown-logout-btn" id="logoutBtn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            Sign Out
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- MAIN SHELL -->
  <div class="shell" id="mainShell">

    <!-- LEFT WELCOME SECTION -->
    <aside class="welcome" id="welcomeSidebar">
      <span class="welcome-back">Welcome back</span>
      <h1>Welcome to myAtlas Admin Portal</h1>
      <p>You can create application cycles, manage applications, view submitted documents and update their status — all from one place.</p>
      
      <button class="primary" id="openModalBtn">
        <span class="plus-sign">+</span>Create application cycle
      </button>

      <div class="divider-line" aria-hidden="true"></div>

      <div class="setup-card">
        <div class="setup-icon-wrap" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M12 3a7 7 0 0 0-4 12.75V19h8v-3.25A7 7 0 0 0 12 3z"></path>
            <path d="M9 22h6M9 19h6"></path>
          </svg>
        </div>
        <div class="setup-content">
          <h3>Need help getting started?</h3>
          <p>Check out our quick guide to set up your first application cycle and manage your admissions process.</p>
          <a class="setup-link" href="#" onclick="return false;" id="guideLink">View setup guide →</a>
        </div>
      </div>
    </aside>

    <!-- RIGHT CONTENT SECTION -->
    <main class="main" id="mainContentArea">
      <!-- VIEW 1: Default Dashboard -->
      <div id="dashboardView">
        <h2 class="section-heading">How it works</h2>
        <p class="section-sub">Follow these simple steps to set up your first application cycle and start receiving applications from students.</p>

        <div class="grid-2x2">
          <!-- Step 1 -->
          <div class="step-card">
            <div class="card-top-row">
              <div class="step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <rect x="4" y="5" width="16" height="15" rx="2"></rect>
                  <path d="M8 3v4M16 3v4M4 10h16"></path>
                </svg>
              </div>
              <span class="step-number">1</span>
            </div>
            <div class="step-body">
              <h3>Create Application Cycle</h3>
              <p>Set opening/closing dates, select degree types and key details for your cycle.</p>
            </div>
            <a class="see-more action-step-1" href="#" onclick="return false;">See more →</a>
          </div>

          <!-- Step 2 -->
          <div class="step-card">
            <div class="card-top-row">
              <div class="step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"></path>
                </svg>
              </div>
              <span class="step-number">2</span>
            </div>
            <div class="step-body">
              <h3>View Applications</h3>
              <p>Review and manage incoming applications.</p>
            </div>
            <a class="see-more" id="viewAppsBtn" href="#" onclick="return false;">See more →</a>
          </div>

          <!-- Step 3 -->
          <div class="step-card">
            <div class="card-top-row">
              <div class="step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <span class="step-number">3</span>
            </div>
            <div class="step-body">
              <h3>Manage Fields</h3>
              <p>Configure the information you want to collect from applicants.</p>
            </div>
            <a class="see-more" id="manageFieldsBtn" href="#" onclick="return false;">See more →</a>
          </div>

          <!-- Step 4 -->
          <div class="step-card">
            <div class="card-top-row">
              <div class="step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M18 20V10M12 20V4M6 20v-6"></path>
                </svg>
              </div>
              <span class="step-number">4</span>
            </div>
            <div class="step-body">
              <h3>View Reports</h3>
              <p>Track progress and download reports.</p>
            </div>
            <a class="see-more" id="viewReportsBtn" href="#" onclick="return false;">See more →</a>
          </div>
        </div>
      </div>

      <!-- VIEW 2: Application Cycle Builder Workspace (Step 1: Basic Info) -->
      <div id="cycleBuilderView" style="display: none;">
        
        <!-- PAGE TITLE -->
        <header class="page-heading">
          <h1>Create Application Cycle</h1>
          <p>
            Set up the basic information for your application cycle.
            You can complete the other sections later.
          </p>
        </header>

        <!-- HORIZONTAL FIVE-STEP PROGRESS -->
        <nav class="steps" aria-label="Application cycle steps">
          <div class="step active" id="navStep1">
            <span class="step-number">1</span>
            <span>Basic Info</span>
          </div>

          <div class="step" id="navStep2">
            <span class="step-number">2</span>
            <span>Application Form</span>
          </div>

          <div class="step" id="navStep3">
            <span class="step-number">3</span>
            <span>Courses</span>
          </div>

          <div class="step" id="navStep4">
            <span class="step-number">4</span>
            <span>Documents</span>
          </div>

          <div class="step" id="navStep5">
            <span class="step-number">5</span>
            <span>Review &amp; Publish</span>
          </div>
        </nav>

        <!-- SUB-VIEW 1: BASIC INFO -->
        <div id="builderStep1">
          <section class="details-card">
            <div class="card-heading">
              <div class="heading-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="3" ry="3"></rect>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
              </div>              
              <div>
                <h2>Application Details</h2>
                <p>
                  Enter the key details for your application cycle.
                  The system will automatically create the folder and
                  cycle name based on the information you provide.
                </p>
              </div>
            </div>

            <!-- FOUR REQUIRED FIELDS -->
            <div class="fields-grid">
              <div class="field">
                <label for="qualification">
                  Qualification Type <span class="required">*</span>
                </label>
                <select id="qualification" class="control">
                  <option value="" selected disabled>
                    Select qualification type
                  </option>
                  <option value="Undergraduate Degree">Undergraduate Degree</option>
                  <option value="Postgraduate Degree">Postgraduate Degree</option>
                  <option value="Research Degree">Research Degree</option>
                </select>
              </div>

              <div class="field">
                <label for="academic-year">
                  Academic Year <span class="required">*</span>
                </label>
                <select id="academic-year" class="control">
                  <option value="" selected disabled>
                    Select academic year
                  </option>
                </select>
              </div>

              <div class="field">
                <label for="opening-date">
                  Opening Date <span class="required">*</span>
                </label>
                <input
                  id="opening-date"
                  class="control"
                  type="date"
                  aria-label="Opening date"
                >
              </div>

              <div class="field">
                <label for="closing-date">
                  Closing Date <span class="required">*</span>
                </label>
                <input
                  id="closing-date"
                  class="control"
                  type="date"
                  aria-label="Closing date"
                >
              </div>
            </div>

            <!-- AUTOMATIC NAMES -->
            <div class="automatic-section">
              <div class="automatic-field">
                <label for="folder-name">
                  Folder Name <span class="automatic-label">(automatic)</span>
                </label>
                <input
                  id="folder-name"
                  class="automatic-input"
                  type="text"
                  placeholder="Year - Application Cycle"
                  readonly
                  tabindex="-1"
                />
              </div>

              <div class="separator" aria-hidden="true">/</div>

              <div class="automatic-field">
                <label for="cycle-name">
                  Application Cycle Name
                  <span class="automatic-label">(automatic)</span>
                </label>
                <input
                  id="cycle-name"
                  class="automatic-input"
                  type="text"
                  placeholder="{Qualification Type} Applications {Year}"
                  readonly
                  tabindex="-1"
                />
              </div>
            </div>
          </section>

          <!-- BUTTONS -->
          <div class="actions">
            <button type="button" class="btn btn-cancel" id="cancelCycleBtn">
              Cancel
            </button>
            <button type="button" class="btn btn-next" id="nextStepBtn">
              Next: Application Form <span>→</span>
            </button>
          </div>
        </div>

        <!-- SUB-VIEW 2: APPLICATION FORM -->
        <div id="builderStep2" style="display: none;">
          <section class="form-card" style="display: flex; flex-direction: column; gap: 24px;">
            <div class="form-intro">
              <div class="intro-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 3.5h7l5 5V21H7z"></path>
                  <path d="M14 3.5V9h5"></path>
                  <path d="M10 13h6"></path>
                  <path d="M10 17h6"></path>
                </svg>
              </div>
              <div>
                <h2>Application Form</h2>
                <p>
                  Select the information applicants must provide
                  when completing their applications. For each selected field,
                  choose whether it is required or optional.
                </p>
              </div>
            </div>

            <!-- PERSONAL INFORMATION -->
            <section class="information-panel">
              <header class="panel-heading">
                <div class="person-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="7.5" r="3.5"></circle>
                    <path d="M5 20v-2a7 7 0 0 1 14 0v2"></path>
                  </svg>
                </div>
                <div class="panel-title">
                  <h3>Personal Information</h3>
                  <p>Basic details about the applicant.</p>
                </div>
                <div class="panel-meta">
                  <span class="selected-count" id="selectedCountBadge">0 selected</span>
                  <span class="chevron" aria-hidden="true"></span>
                </div>
              </header>

              <!-- SCROLLABLE INFORMATION TABLE -->
              <div class="table-scroll">
                <table>
                  <colgroup>
                    <col class="checkbox-col">
                    <col class="name-col">
                    <col class="requirement-col">
                    <col class="behaviour-col">
                  </colgroup>
                  <thead>
                    <tr>
                      <th>
                        <input
                          type="checkbox"
                          class="check"
                          id="selectAllCheck"
                          aria-label="Select all fields"
                        >
                      </th>
                      <th>Field Name</th>
                      <th>Requirement</th>
                      <th>Field Behaviour</th>
                    </tr>
                  </thead>
                  <tbody id="formFieldsTableBody">
                    <!-- Dynamically populated from Firestore -->
                  </tbody>
                </table>
              </div>
            </section>

            <!-- CONTACT INFORMATION -->
            <section class="information-panel">
              <header class="panel-heading">
                <div class="person-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                </div>
                <div class="panel-title">
                  <h3>Contact Information</h3>
                  <p>Contact details for the applicant.</p>
                </div>
                <div class="panel-meta">
                  <span class="selected-count" id="contactSelectedCountBadge">0 selected</span>
                  <span class="chevron" aria-hidden="true"></span>
                </div>
              </header>

              <!-- SCROLLABLE CONTACT INFORMATION TABLE -->
              <div class="table-scroll">
                <table>
                  <colgroup>
                    <col class="checkbox-col">
                    <col class="name-col">
                    <col class="requirement-col">
                    <col class="behaviour-col">
                  </colgroup>
                  <thead>
                    <tr>
                      <th>
                        <input
                          type="checkbox"
                          class="check"
                          id="selectContactAllCheck"
                          aria-label="Select all contact fields"
                        >
                      </th>
                      <th>Field Name</th>
                      <th>Requirement</th>
                      <th>Field Behaviour</th>
                    </tr>
                  </thead>
                  <tbody id="contactFieldsTableBody">
                    <!-- Dynamically populated from Firestore -->
                  </tbody>
                </table>
              </div>
            </section>

            <!-- PARENT OR GUARDIAN INFORMATION -->
            <section class="information-panel">
              <header class="panel-heading">
                <div class="person-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                  </svg>
                </div>
                <div class="panel-title">
                  <h3>Parent or Guardian Information</h3>
                  <p>Provide the contact details for your parent or guardian. This information helps us keep in touch with you during the application process.</p>
                </div>
                <div class="panel-meta">
                  <span class="selected-count" id="guardianSelectedCountBadge">0 selected</span>
                  <span class="chevron" aria-hidden="true"></span>
                </div>
              </header>

              <!-- SCROLLABLE GUARDIAN INFORMATION TABLE -->
              <div class="table-scroll">
                <table>
                  <colgroup>
                    <col class="checkbox-col">
                    <col class="name-col">
                    <col class="requirement-col">
                    <col class="behaviour-col">
                  </colgroup>
                  <thead>
                    <tr>
                      <th>
                        <input
                          type="checkbox"
                          class="check"
                          id="selectGuardianAllCheck"
                          aria-label="Select all guardian fields"
                        >
                      </th>
                      <th>Field Name</th>
                      <th>Requirement</th>
                      <th>Field Behaviour</th>
                    </tr>
                  </thead>
                  <tbody id="guardianFieldsTableBody">
                    <!-- Dynamically populated from Firestore -->
                  </tbody>
                </table>
              </div>
            </section>

            <!-- EDUCATIONAL BACKGROUND & COURSE SELECTION -->
            <section class="information-panel">
              <header class="panel-heading">
                <div class="person-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                  </svg>
                </div>
                <div class="panel-title">
                  <h3>Educational Background &amp; Course selection</h3>
                  <p>Educational history, current academic status and course choices.</p>
                </div>
                <div class="panel-meta">
                  <span class="selected-count" id="educCoursesSelectedCountBadge">0 selected</span>
                  <span class="chevron" aria-hidden="true"></span>
                </div>
              </header>

              <!-- SCROLLABLE TABLE -->
              <div class="table-scroll">
                <table>
                  <colgroup>
                    <col class="checkbox-col">
                    <col class="name-col">
                    <col class="requirement-col">
                    <col class="behaviour-col">
                  </colgroup>
                  <thead>
                    <tr>
                      <th>
                        <input
                          type="checkbox"
                          class="check"
                          id="selectEducCoursesAllCheck"
                          aria-label="Select all educational and course fields"
                        >
                      </th>
                      <th>Field Name</th>
                      <th>Requirement</th>
                      <th>Field Behaviour</th>
                    </tr>
                  </thead>
                  <tbody id="educCoursesFieldsTableBody">
                    <!-- Dynamically populated from Firestore -->
                  </tbody>
                </table>
              </div>
            </section>

            <!-- ADDITIONAL APPLICANT INFORMATION & DECLARATIONS -->
            <section class="information-panel">
              <header class="panel-heading">
                <div class="person-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    polyline points="10 9 9 9 8 9"></polyline>
                  </svg>
                </div>
                <div class="panel-title">
                  <h3>Additional Applicant Information &amp; Declarations</h3>
                  <p>Employment details, financial aid requirements and legal declarations.</p>
                </div>
                <div class="panel-meta">
                  <span class="selected-count" id="additionalInfoSelectedCountBadge">0 selected</span>
                  <span class="chevron" aria-hidden="true"></span>
                </div>
              </header>

              <!-- SCROLLABLE TABLE -->
              <div class="table-scroll">
                <table>
                  <colgroup>
                    <col class="checkbox-col">
                    <col class="name-col">
                    <col class="requirement-col">
                    <col class="behaviour-col">
                  </colgroup>
