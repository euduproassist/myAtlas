
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Create Application Cycle - Application Form</title>

<style>
:root {
  --blue: #087cff;
  --dark-blue: #003b99;
  --text-blue: #0052bd;
  --light-blue: #eaf5ff;
  --border: #cce4ff;
  --muted-blue: #5599ec;
  --white: #ffffff;
}

* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  min-height: 100%;
  background: #fff;
  font-family: Arial, Helvetica, sans-serif;
  color: var(--text-blue);
  font-size: 13px;
}

button, input, select {
  font: inherit;
}

.page {
  width: 100%;
  padding: 0 2.2% 24px;
}

/* PAGE HEADING */

.page-heading {
  margin: -3px 0 17px;
}

.page-heading h1 {
  margin: 0 0 5px;
  color: var(--dark-blue);
  font-size: clamp(25px, 2.1vw, 32px);
  line-height: 1.3;
  letter-spacing: -0.5px;
  font-weight: 750;
}

.page-heading p {
  margin: 0;
  color: var(--muted-blue);
  font-size: 13px;
  line-height: 1.5;
}

/* FIVE HORIZONTAL STEPS */

.steps {
  display: flex;
  width: 100%;
  min-height: 46px;
  margin-bottom: 19px;
  overflow-x: auto;
  overflow-y: hidden;
  border: 1px solid var(--border);
  border-radius: 5px;
  background: #fff;
  scrollbar-width: thin;
  scrollbar-color: #c8e2ff #fff;
}

.step {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  flex: 1 0 160px;
  min-width: 160px;
  min-height: 44px;
  padding: 7px 12px;
  white-space: nowrap;
  color: #0073ff;
}

.step:not(:last-child)::after {
  content: "";
  position: absolute;
  right: 0;
  top: 11px;
  width: 1px;
  height: 23px;
  background: #d5e9ff;
}

.step.active {
  font-weight: 700;
}

.step.active::before {
  content: "";
  position: absolute;
  bottom: 0;
  left: 12px;
  right: 0;
  height: 3px;
  background: var(--blue);
}

.step-number {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 26px;
  width: 26px;
  height: 26px;
  border: 1px solid #8dc3ff;
  border-radius: 50%;
  color: var(--dark-blue);
  background: #fff;
  font-size: 13px;
  font-weight: 700;
}

.step.completed .step-number,
.step.active .step-number {
  color: #fff;
  background: var(--blue);
  border-color: var(--blue);
}

.step.completed .step-number {
  font-size: 0;
}

.step.completed .step-number::after {
  content: "✓";
  font-size: 15px;
}

/* MAIN APPLICATION FORM CARD */

.form-card {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 5px;
  padding: 16px 19px 15px;
  background: #fff;
}

.form-intro {
  display: flex;
  align-items: flex-start;
  gap: 21px;
  margin-bottom: 22px;
}

.intro-icon {
  flex: 0 0 50px;
  width: 50px;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--blue);
  background: #e8f4ff;
  border-radius: 50%;
}

.intro-icon svg {
  width: 26px;
  height: 26px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.9;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.form-intro h2 {
  margin: 4px 0 11px;
  color: var(--dark-blue);
  font-size: 16px;
  font-weight: 750;
}

.form-intro p {
  margin: 0;
  color: var(--muted-blue);
  font-size: 12.5px;
  line-height: 1.55;
}

/* PERSONAL INFORMATION PANEL */

.information-panel {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 5px;
  overflow: hidden;
}

.panel-heading {
  display: flex;
  align-items: center;
  min-height: 64px;
  padding: 10px 22px;
  gap: 22px;
  background: #fff;
}

.person-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 19px;
  color: var(--blue);
}

.person-icon svg {
  width: 20px;
  height: 20px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.panel-title {
  min-width: 0;
}

.panel-title h3 {
  margin: 0 0 7px;
  color: var(--dark-blue);
  font-size: 15px;
  font-weight: 750;
}

.panel-title p {
  margin: 0;
  color: var(--muted-blue);
  font-size: 12px;
}

.panel-meta {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-left: auto;
  white-space: nowrap;
}

.selected-count {
  padding: 5px 12px;
  border-radius: 18px;
  background: #e4f3ff;
  color: #0074f5;
  font-size: 11px;
}

.chevron {
  width: 9px;
  height: 9px;
  border-top: 2px solid var(--blue);
  border-left: 2px solid var(--blue);
  transform: rotate(45deg);
  margin-top: 5px;
}

/* SCROLLABLE TABLE */

.table-scroll {
  width: 100%;
  max-height: 468px;
  overflow: auto;
  scrollbar-width: thin;
  scrollbar-color: #b7d8f9 #edf6ff;
}

.table-scroll::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}

.table-scroll::-webkit-scrollbar-track {
  background: #edf6ff;
}

.table-scroll::-webkit-scrollbar-thumb {
  background: #b7d8f9;
  border-radius: 10px;
}

table {
  width: 100%;
  min-width: 760px;
  table-layout: fixed;
  border-collapse: collapse;
  color: var(--text-blue);
  font-size: 12px;
}

col.checkbox-col {
  width: 7.5%;
}

col.name-col {
  width: 41%;
}

col.requirement-col {
  width: 23.5%;
}

col.behaviour-col {
  width: 28%;
}

thead {
  position: sticky;
  top: 0;
  z-index: 2;
}

thead th {
  height: 39px;
  padding: 8px 10px;
  background: #edf6ff;
  color: #2783df;
  font-size: 12px;
  font-weight: 700;
  text-align: left;
  border-bottom: 1px solid #e1efff;
}

thead th:first-child {
  padding-left: 21px;
}

tbody tr {
  height: 39px;
  border-bottom: 1px solid #e0edfc;
}

tbody tr:last-child {
  border-bottom: 0;
}

tbody td {
  height: 39px;
  padding: 4px 10px;
  vertical-align: middle;
  background: #fff;
}

tbody td:first-child {
  padding-left: 21px;
}

tbody td:nth-child(2) {
  font-size: 12px;
}

.check {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 17px;
  height: 17px;
  margin: 0;
  vertical-align: middle;
  appearance: none;
  -webkit-appearance: none;
  border: 1px solid #80baff;
  border-radius: 4px;
  background: #fff;
  cursor: default;
}

.check:checked {
  background: var(--blue);
  border-color: var(--blue);
}

.check:checked::after {
  content: "";
  width: 8px;
  height: 4px;
  margin-top: -2px;
  border-left: 2px solid white;
  border-bottom: 2px solid white;
  transform: rotate(-45deg);
}

/* REQUIREMENT SELECTS */

.requirement-select {
  width: 100%;
  max-width: 269px;
  height: 28px;
  padding: 0 9px;
  border: 1px solid #c8e2ff;
  border-radius: 5px;
  background: #fff;
  color: #0052bd;
  outline: none;
  font-size: 12px;
  cursor: default;
}

/* FIELD BEHAVIOUR TAGS */

.behaviour {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 21px;
  padding: 3px 12px;
  border-radius: 14px;
  background: #e8f4ff;
  color: #3185e0;
  font-size: 11px;
  white-space: nowrap;
}

.behaviour.conditional {
  background: #d7f8f3;
  color: #00a6b4;
}

.behaviour.not-conditional {
  background: #e8f4ff;
  color: #3185e0;
}

.behaviour-group {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.behaviour-arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border: 0;
  border-radius: 50%;
  background: #d7f8f3;
  color: #00a5b7;
  font-size: 14px;
  line-height: 1;
}

/* BOTTOM ACTION BUTTONS */

.actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 13px;
  margin-top: 17px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 37px;
  padding: 0 17px;
  border: 1px solid var(--blue);
  border-radius: 5px;
  background: #fff;
  color: #0071f5;
  font-size: 11px;
  white-space: nowrap;
  cursor: default;
}

.btn-cancel {
  min-width: 90px;
}

.btn-previous {
  min-width: 149px;
}

.btn-next {
  min-width: 136px;
  color: #fff;
  background: var(--blue);
}

.btn .arrow {
  font-size: 16px;
  line-height: 1;
}

/* RESPONSIVE LAYOUT */

@media (max-width: 800px) {
  .page {
    padding: 12px 16px 22px;
  }

  .page-heading h1 {
    font-size: 27px;
  }

  .steps {
    margin-bottom: 15px;
  }

  .form-card {
    padding: 15px 12px 13px;
  }

  .form-intro {
    gap: 13px;
    margin-bottom: 18px;
  }

  .panel-heading {
    padding: 10px 13px;
    gap: 13px;
  }

  .actions {
    flex-wrap: wrap;
    gap: 9px;
  }
}

@media (max-width: 520px) {
  .page {
    padding: 15px 10px 20px;
  }

  .page-heading h1 {
    font-size: 24px;
  }

  .page-heading p {
    font-size: 12px;
  }

  .step {
    flex-basis: 150px;
    min-width: 150px;
    gap: 9px;
    font-size: 12px;
  }

  .form-intro {
    align-items: flex-start;
  }

  .intro-icon {
    flex-basis: 42px;
    width: 42px;
    height: 42px;
  }

  .form-intro h2 {
    font-size: 15px;
  }

  .form-intro p {
    font-size: 12px;
  }

  .panel-heading {
    gap: 9px;
    padding: 10px;
  }

  .panel-title h3 {
    font-size: 13px;
  }

  .panel-title p {
    font-size: 11px;
  }

  .panel-meta {
    gap: 7px;
  }

  .selected-count {
    padding: 5px 8px;
    font-size: 10px;
  }

  .table-scroll {
    max-height: 440px;
  }

  .actions {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
  }

  .btn {
    min-width: 0;
    padding: 0 8px;
    font-size: 10px;
  }
}
</style>
</head>

<body>
<main class="page">

  <!-- HEADING -->
  <header class="page-heading">
    <h1>Create Application Cycle</h1>
    <p>
      Set up the basic information for your application cycle.
      You can complete the other sections later.
    </p>
  </header>

  <!-- FIVE STEP NAVIGATION -->
  <nav class="steps" aria-label="Application cycle progress">

    <div class="step completed">
      <span class="step-number">1</span>
      <span>Basic Info</span>
    </div>

    <div class="step active">
      <span class="step-number">2</span>
      <span>Application Form</span>
    </div>

    <div class="step">
      <span class="step-number">3</span>
      <span>Courses</span>
    </div>

    <div class="step">
      <span class="step-number">4</span>
      <span>Documents</span>
    </div>

    <div class="step">
      <span class="step-number">5</span>
      <span>Review &amp; Publish</span>
    </div>

  </nav>

  <!-- MAIN FORM CARD -->
  <section class="form-card">

    <div class="form-intro">

      <div class="intro-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="M7 3.5h7l5 5V21H7z"></path>
          <path d="M14 3.5V9h5"></path>
          <path d="M10 13h6"></path>
          <path d="M10 17h6"></path>
        </svg>
      </div>

      <div>
        <h2>Application Form</h2>
        <p>
          Select the information undergraduate applicants must provide
          when completing their applications. For each selected field,
          choose whether it is required or optional.
        </p>
      </div>

    </div>

    <!-- PERSONAL INFORMATION -->
    <section class="information-panel">

      <header class="panel-heading">

        <div class="person-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="7.5" r="3.5"></circle>
            <path d="M5 20v-2a7 7 0 0 1 14 0v2"></path>
          </svg>
        </div>

        <div class="panel-title">
          <h3>Personal Information</h3>
          <p>Basic details about the applicant.</p>
        </div>

        <div class="panel-meta">
          <span class="selected-count">11 selected</span>
          <span class="chevron" aria-hidden="true"></span>
        </div>

      </header>

      <!-- SCROLLABLE INFORMATION TABLE -->
      <div class="table-scroll">

        <table>
          <colgroup>
            <col class="checkbox-col">
            <col class="name-col">
            <col class="requirement-col">
            <col class="behaviour-col">
          </colgroup>

          <thead>
            <tr>
              <th>
                <input
                  type="checkbox"
                  class="check"
                  aria-label="Select all fields"
                >
              </th>
              <th>Field Name</th>
              <th>Requirement</th>
              <th>Field Behaviour</th>
            </tr>
          </thead>

          <tbody>

            <tr>
              <td><input type="checkbox" class="check" checked aria-label="Include First Name"></td>
              <td>First Name</td>
              <td>
                <select class="requirement-select" aria-label="First Name requirement">
                  <option selected>Required</option>
                  <option>Optional</option>
                </select>
              </td>
              <td><span class="behaviour">Standard</span></td>
            </tr>

            <tr>
              <td><input type="checkbox" class="check" checked aria-label="Include Middle Name"></td>
              <td>Middle Name(s)</td>
              <td>
                <select class="requirement-select" aria-label="Middle Names requirement">
                  <option>Required</option>
                  <option selected>Optional</option>
                </select>
              </td>
              <td><span class="behaviour">Standard</span></td>
            </tr>

            <tr>
              <td><input type="checkbox" class="check" checked aria-label="Include Surname"></td>
              <td>Surname</td>
              <td>
                <select class="requirement-select" aria-label="Surname requirement">
                  <option selected>Required</option>
                  <option>Optional</option>
                </select>
              </td>
              <td><span class="behaviour">Standard</span></td>
            </tr>

            <tr>
              <td><input type="checkbox" class="check" checked aria-label="Include Date of Birth"></td>
              <td>Date of Birth</td>
              <td>
                <select class="requirement-select" aria-label="Date of Birth requirement">
                  <option selected>Required</option>
                  <option>Optional</option>
                </select>
              </td>
              <td><span class="behaviour">Standard</span></td>
            </tr>

            <tr>
              <td><input type="checkbox" class="check" checked aria-label="Include Gender"></td>
              <td>Gender</td>
              <td>
                <select class="requirement-select" aria-label="Gender requirement">
                  <option>Required</option>
                  <option selected>Optional</option>
                </select>
              </td>
              <td><span class="behaviour">Standard</span></td>
            </tr>

            <tr>
              <td><input type="checkbox" class="check" checked aria-label="Include South African ID Number"></td>
              <td>South African ID Number</td>
              <td>
                <select class="requirement-select" aria-label="South African ID Number requirement">
                  <option selected>Required</option>
                  <option>Optional</option>
                </select>
              </td>
              <td>
                <span class="behaviour-group">
                  <span class="behaviour conditional">Conditional</span>
                  <span class="behaviour-arrow" aria-hidden="true">⌄</span>
                </span>
              </td>
            </tr>

            <tr>
              <td><input type="checkbox" class="check" aria-label="Include Passport Number"></td>
              <td>Passport Number</td>
              <td>
                <select class="requirement-select" aria-label="Passport Number requirement">
                  <option>Required</option>
                  <option selected>Optional</option>
                </select>
              </td>
              <td>
                <span class="behaviour-group">
                  <span class="behaviour conditional">Conditional</span>
                  <span class="behaviour-arrow" aria-hidden="true">⌄</span>
                </span>
              </td>
            </tr>

            <tr>
              <td><input type="checkbox" class="check" checked aria-label="Include Nationality"></td>
              <td>Nationality</td>
              <td>
                <select class="requirement-select" aria-label="Nationality requirement">
                  <option selected>Required</option>
                  <option>Optional</option>
                </select>
              </td>
              <td><span class="behaviour">Standard</span></td>
            </tr>

            <tr>
              <td><input type="checkbox" class="check" aria-label="Include Home Language"></td>
              <td>Home Language</td>
              <td>
                <select class="requirement-select" aria-label="Home Language requirement">
                  <option>Required</option>
                  <option selected>Optional</option>
                </select>
              </td>
              <td>
                <span class="behaviour-group">
                  <span class="behaviour conditional">Conditional</span>
                  <span class="behaviour-arrow" aria-hidden="true">⌄</span>
                </span>
              </td>
            </tr>

            <tr>
              <td><input type="checkbox" class="check" aria-label="Include Disability Information"></td>
              <td>Disability Information</td>
              <td>
                <select class="requirement-select" aria-label="Disability Information requirement">
                  <option>Required</option>
                  <option selected>Optional</option>
                </select>
              </td>
              <td>
                <span class="behaviour-group">
                  <span class="behaviour conditional">Conditional</span>
                  <span class="behaviour-arrow" aria-hidden="true">⌄</span>
                </span>
              </td>
            </tr>

            <tr>
              <td><input type="checkbox" class="check" aria-label="Include Marital Status"></td>
              <td>Marital Status</td>
              <td>
                <select class="requirement-select" aria-label="Marital Status requirement">
                  <option>Required</option>
                  <option selected>Optional</option>
                </select>
              </td>
              <td><span class="behaviour not-conditional">Not Conditional</span></td>
            </tr>

          </tbody>
        </table>

      </div>
    </section>

  </section>

  <!-- BUTTONS OUTSIDE THE CARD -->
  <div class="actions">

    <button type="button" class="btn btn-cancel">
      Cancel
    </button>

    <button type="button" class="btn btn-previous">
      <span class="arrow" aria-hidden="true">←</span>
      Previous: Basic Info
    </button>

    <button type="button" class="btn btn-next">
      Next: Courses
      <span class="arrow" aria-hidden="true">→</span>
    </button>

  </div>

</main>
</body>
</html>
