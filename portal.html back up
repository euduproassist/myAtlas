<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffffff">
  <title>myAtlas — Student Portal</title>

  <style>
    :root {
      --blue: #0866f5;
      --blue-dark: #0647ad;
      --navy: #071c72;
      --text: #244b88;
      --muted: #7897c5;
      --border: #cfe3ff;
      --pale-blue: #eaf5ff;
      --white: #ffffff;
      --line: #d8e8f8;
      --border-light: #cfe3f7;
      --shadow: 0 1px 4px rgba(24, 76, 125, .05);
      --green-bg: #e2f5e9;
      --green-text: #138742;
      --grey-bg: #e8edf5;
      --grey-text: #506687;
      --red-bg: #fde8e9;
      --red-text: #e53e3e;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      width: 100%;
      min-height: 100%;
      overflow-x: hidden;
      scroll-behavior: smooth;
      background: #ffffff;
    }

    body {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      min-height: 100vh;
      overflow-x: hidden;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
        Roboto, Helvetica, Arial, sans-serif;
      color: var(--text);
      background: #ffffff;
      font-size: 14px;
      -webkit-font-smoothing: antialiased;
      display: flex;
      flex-direction: column;
    }

    button,
    input {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    img,
    svg {
      display: block;
      max-width: 100%;
    }

    p,
    h1,
    h2,
    h3,
    a,
    span {
      overflow-wrap: break-word;
    }

    button:focus-visible,
    input:focus-visible {
      outline: 2px solid #70aaff;
      outline-offset: 2px;
    }

    /* PAGE */
    .page {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      min-height: 100vh;
      margin: 0;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    /* HEADER */
    .topbar {
      width: 100%;
      max-width: 100%;
      height: 72px;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 25px;
      background: #ffffff;
      flex-shrink: 0;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 16px;
      flex: 0 0 auto;
    }

    .brand-logo {
      width: 132px;
      height: auto;
      display: block;
    }

    .top-right {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    /* LOG OUT */
    .logout-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--blue);
      font-size: 13.5px;
      font-weight: 650;
      transition: background .15s ease;
    }

    .logout-btn:hover {
      background: var(--pale-blue);
    }

    .logout-btn svg {
      width: 16px;
      height: 16px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* VIEW LAYOUT */
    .view-container {
      flex: 1;
      width: 100%;
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    /* LOGIN SCREEN — NO OUTER CARD */
    #loginView {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
      width: 100%;
    }

    .login-card-wrapper {
      width: 100%;
      max-width: 480px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .login-icon-circle {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: var(--pale-blue);
      display: grid;
      place-items: center;
      color: var(--blue);
      margin-bottom: 24px;
      flex-shrink: 0;
    }

    .login-icon-circle svg {
      width: 34px;
      height: 34px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .login-card-wrapper h1 {
      font-size: clamp(28px, 3.5vw, 34px);
      font-weight: 800;
      color: var(--navy);
      margin-bottom: 10px;
      letter-spacing: -.6px;
    }

    .login-card-wrapper p.login-subtitle {
      font-size: 14.5px;
      color: var(--muted);
      line-height: 1.5;
      margin-bottom: 32px;
      max-width: 400px;
    }

    .form-group {
      width: 100%;
      min-width: 0;
      text-align: left;
      margin-bottom: 20px;
    }

    .form-group label {
      display: block;
      font-size: 13.5px;
      font-weight: 700;
      color: var(--navy);
      margin-bottom: 8px;
    }

    .form-group label .required {
      color: #e53b4d;
      margin-left: 2px;
    }

    .form-control {
      width: 100%;
      height: 46px;
      padding: 0 16px;
      border: 1px solid var(--border-light);
      border-radius: 6px;
      background: #ffffff;
      color: var(--navy);
      font-size: 14px;
      transition: border-color .15s, box-shadow .15s;
    }

    .form-control:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(8, 102, 245, .1);
      outline: none;
    }

    .form-control::placeholder {
      color: #9cb5db;
    }

    .forgot-link-wrap {
      width: 100%;
      text-align: left;
      margin-bottom: 24px;
    }

    .forgot-link {
      color: var(--blue);
      font-size: 13.5px;
      font-weight: 600;
      display: inline-block;
    }

    .forgot-link:hover {
      text-decoration: underline;
    }

    .btn-check-status {
      width: 100%;
      height: 48px;
      background: var(--blue);
      color: #ffffff;
      border: none;
      border-radius: 6px;
      font-size: 14.5px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 2px 6px rgba(8, 102, 245, .25);
      transition: background .15s;
      margin-bottom: 32px;
    }

    .btn-check-status:hover {
      background: var(--blue-dark);
    }

    .login-divider {
      width: 100%;
      height: 1px;
      background: var(--line);
      margin-bottom: 32px;
      flex-shrink: 0;
    }

    .apply-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      width: 100%;
      font-size: 13.5px;
      color: var(--muted);
    }

    .btn-apply-now {
      padding: 8px 20px;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: #ffffff;
      color: var(--blue);
      font-weight: 650;
      font-size: 13.5px;
      transition: background .15s;
    }

    .btn-apply-now:hover {
      background: var(--pale-blue);
    }

    /* RECOVERY POPUP */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      background: rgba(7, 28, 114, .35);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 20px;
      overflow-y: auto;
    }

    .modal-backdrop.active {
      display: flex;
    }

    .modal-card {
      width: 100%;
      max-width: 520px;
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 15px 35px rgba(7, 28, 114, .18);
      border: 1px solid var(--border-light);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      animation: modalScaleIn .2s cubic-bezier(.16, 1, .3, 1) forwards;
      margin: auto;
    }

    @keyframes modalScaleIn {
      from {
        opacity: 0;
        transform: scale(.95) translateY(10px);
      }
      to {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 24px 28px 20px;
      border-bottom: 1px solid var(--line);
      gap: 16px;
    }

    .modal-title-area {
      display: flex;
      align-items: center;
      gap: 16px;
      min-width: 0;
    }

    .modal-lock-icon {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--pale-blue);
      display: grid;
      place-items: center;
      color: var(--blue);
      flex-shrink: 0;
    }

    .modal-lock-icon svg {
      width: 22px;
      height: 22px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .modal-header h2 {
      font-size: 20px;
      font-weight: 750;
      color: var(--navy);
      letter-spacing: -.3px;
    }

    .modal-close-btn {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: none;
      background: transparent;
      display: grid;
      place-items: center;
      color: #7b96b6;
      flex-shrink: 0;
      transition: background .15s, color .15s;
    }

    .modal-close-btn:hover {
      background: #f0f6ff;
      color: var(--navy);
    }

    .modal-close-btn svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .modal-body {
      padding: 28px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .modal-body p.modal-instruction {
      font-size: 14px;
      color: var(--text);
      line-height: 1.55;
    }

    .modal-input-wrap {
      position: relative;
      display: flex;
      align-items: center;
      width: 100%;
    }

    .modal-input-icon {
      position: absolute;
      left: 14px;
      color: #9cb5db;
      display: grid;
      place-items: center;
      pointer-events: none;
    }

    .modal-input-icon svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .modal-control {
      width: 100%;
      min-width: 0;
      height: 46px;
      padding: 0 14px 0 44px;
      border: 1px solid var(--border-light);
      border-radius: 6px;
      background: #ffffff;
      color: var(--navy);
      font-size: 14px;
    }

    .modal-control:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(8, 102, 245, .1);
      outline: none;
    }

    .modal-control::placeholder {
      color: #9cb5db;
    }

    .btn-send-details {
      width: 100%;
      height: 46px;
      background: var(--blue);
      color: #ffffff;
      border: none;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background .15s;
      box-shadow: 0 2px 5px rgba(8, 102, 245, .2);
    }

    .btn-send-details:hover {
      background: var(--blue-dark);
    }

    .modal-info-box {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 16px;
      background: var(--pale-blue);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text);
      font-size: 13px;
      line-height: 1.5;
    }

    .modal-info-icon {
      color: var(--blue);
      flex-shrink: 0;
      margin-top: 1px;
    }

    .modal-info-icon svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* APPLICATION STATUS PORTAL */
    #statusPortalView {
      display: none;
      flex: 1;
      width: 100%;
      max-width: 840px;
      margin: 0 auto;
      padding: 40px 24px;
      min-width: 0;
    }

    #statusPortalView.active {
      display: flex;
      flex-direction: column;
    }

    .portal-welcome-row {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 28px;
    }

    .portal-avatar {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: var(--pale-blue);
      color: var(--blue);
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }

    .portal-avatar svg {
      width: 26px;
      height: 26px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .portal-welcome-text h2 {
      font-size: clamp(22px, 2.5vw, 26px);
      font-weight: 800;
      color: var(--navy);
      margin-bottom: 4px;
      letter-spacing: -.4px;
    }

    .portal-welcome-text p {
      font-size: 13.5px;
      color: var(--muted);
      font-weight: 500;
    }

    /* ONE UNIFIED STATUS CARD */
    .status-main-card {
      width: 100%;
      min-width: 0;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: #ffffff;
      overflow: hidden;
      box-shadow: var(--shadow);
    }

    .status-header-box {
      background: var(--pale-blue);
      border-bottom: 1px solid var(--border);
      padding: 24px;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .status-file-icon {
      width: 44px;
      height: 44px;
      border-radius: 6px;
      background: #ffffff;
      border: 1px solid var(--border);
      display: grid;
      place-items: center;
      color: var(--blue);
      flex-shrink: 0;
    }

    .status-file-icon svg {
      width: 22px;
      height: 22px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .status-header-info {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .status-label-small {
      font-size: 11px;
      font-weight: 750;
      letter-spacing: .8px;
      color: var(--muted);
      text-transform: uppercase;
    }

    .status-value-bold {
      font-size: 19px;
      font-weight: 800;
      color: var(--blue);
      letter-spacing: -.3px;
    }

    .status-meta-section {
      padding: 24px;
      border-bottom: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .meta-row {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .meta-title {
      font-size: 12.5px;
      color: var(--muted);
      font-weight: 500;
    }

    .meta-data {
      font-size: 15px;
      font-weight: 750;
      color: var(--navy);
    }

    .docs-section-heading {
      padding: 20px 24px 12px;
      font-size: 15px;
      font-weight: 750;
      color: var(--navy);
    }

    .docs-table-list {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    .doc-item-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 24px;
      border-top: 1px solid var(--line);
      gap: 16px;
      flex-wrap: wrap;
    }

    .doc-item-name {
      font-size: 14px;
      font-weight: 600;
      color: var(--text);
      flex: 1 1 200px;
      min-width: 0;
    }

    .doc-item-right {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 12px;
      flex-wrap: wrap;
    }

    /* DOCUMENT STATUS PILLS */
    .status-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 5px 14px;
      border-radius: 16px;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    .status-badge.received {
      background: var(--green-bg);
      color: var(--green-text);
    }

    .status-badge.not-uploaded {
      background: var(--grey-bg);
      color: var(--grey-text);
    }

    .status-badge.denied {
      background: var(--red-bg);
      color: var(--red-text);
    }

    .status-reason {
      font-size: 13px;
      color: #e53e3e;
      font-weight: 600;
    }

    /* DOCUMENT BUTTONS — DISPLAY ONLY */
    .btn-doc-action {
      padding: 6px 16px;
      border-radius: 6px;
      font-size: 12.5px;
      font-weight: 650;
      background: #ffffff;
      border: 1px solid var(--border);
      color: var(--blue);
      white-space: nowrap;
      transition: background .15s;
    }

    .btn-doc-action:hover {
      background: var(--pale-blue);
    }

    .btn-doc-action.upload {
      background: var(--blue);
      color: #ffffff;
      border: none;
      box-shadow: 0 1px 3px rgba(8, 102, 245, .2);
    }

    .btn-doc-action.upload:hover {
      background: var(--blue-dark);
    }

    /* FOOTER */
    .footer {
      width: 100%;
      max-width: 100%;
      border-top: 1px solid var(--line);
      background: #ffffff;
      padding: 24px 25px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-shrink: 0;
    }

    .footer-left {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      color: var(--muted);
      font-weight: 500;
    }

    .footer-left svg {
      width: 16px;
      height: 16px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      flex-shrink: 0;
    }

    .footer-right {
      font-size: 13px;
      color: var(--muted);
      font-weight: 500;
      white-space: nowrap;
    }

    .footer-right a {
      color: var(--blue);
    }

    .footer-right a:hover {
      text-decoration: underline;
    }

    /* TABLET AND MOBILE */
    @media (max-width: 768px) {
      .topbar {
        padding: 0 16px;
        height: 64px;
      }

      #loginView {
        padding: 30px 16px;
      }

      #statusPortalView {
        padding: 24px 16px;
      }

      .footer {
        padding: 20px 16px;
        flex-direction: column;
        gap: 12px;
        align-items: flex-start;
      }

      .doc-item-row {
        padding: 12px 16px;
      }

      .status-header-box,
      .status-meta-section,
      .docs-section-heading {
        padding-left: 16px;
        padding-right: 16px;
      }
    }

    @media (max-width: 480px) {
      .brand-logo {
        width: 116px;
      }

      .login-card-wrapper h1 {
        letter-spacing: -.4px;
      }

      .apply-row {
        flex-wrap: wrap;
      }

      .modal-backdrop {
        padding: 12px;
      }

      .modal-header {
        padding: 18px 16px;
        gap: 10px;
      }

      .modal-title-area {
        gap: 10px;
      }

      .modal-header h2 {
        font-size: 18px;
      }

      .modal-body {
        padding: 18px 16px;
        gap: 16px;
      }

      .doc-item-name {
        flex-basis: 100%;
      }

      .doc-item-right {
        width: 100%;
        justify-content: space-between;
        gap: 8px;
      }

      .btn-doc-action {
        white-space: normal;
        text-align: center;
      }

      .portal-welcome-row {
        gap: 12px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>
  <div class="page">

    <!-- TOP BAR -->
    <header class="topbar">
      <div class="brand">
        <a href="#" aria-label="myAtlas home" onclick="return false;">
          <img class="brand-logo" src="assets/logos.png" alt="myAtlas College">
        </a>
      </div>

      <!-- Only shown on the portal screen -->
      <div id="topRightNav" style="display: none;">
        <button type="button" class="logout-btn" id="logoutBtn">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          Log Out
        </button>
      </div>
    </header>

    <div class="view-container">

      <!-- VIEW 1: LOGIN -->
      <section id="loginView">
        <div class="login-card-wrapper">

          <div class="login-icon-circle" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <rect x="4" y="3" width="16" height="18" rx="2"></rect>
              <line x1="8" y1="7" x2="16" y2="7"></line>
              <line x1="8" y1="11" x2="16" y2="11"></line>
              <line x1="8" y1="15" x2="12" y2="15"></line>
            </svg>
          </div>

          <h1>Track Application Status</h1>

          <p class="login-subtitle">
            Enter your details below to check your progress or upload requested documents.
          </p>

          <div class="form-group">
            <label for="loginId">
              National ID or Passport Number
              <span class="required">*</span>
            </label>
            <input
              type="text"
              id="loginId"
              class="form-control"
              placeholder="e.g., 0405125800088 / A01234567"
              autocomplete="off"
            >
          </div>

          <div class="form-group">
            <label for="loginRef">
              Application Reference Number
              <span class="required">*</span>
            </label>
            <input
              type="text"
              id="loginRef"
              class="form-control"
              placeholder="e.g., ATL-2026-8942"
              autocomplete="off"
            >
          </div>

          <div class="form-group">
            <label for="loginPin">
              4-Digit PIN
              <span class="required">*</span>
            </label>
            <input
              type="password"
              id="loginPin"
              class="form-control"
              placeholder="****"
              maxlength="4"
              inputmode="numeric"
              autocomplete="off"
            >
          </div>

          <div class="forgot-link-wrap">
            <a href="#" class="forgot-link" id="forgotLink">
              Forgot PIN or Reference Number?
            </a>
          </div>

          <button type="button" class="btn-check-status" id="checkStatusBtn">
            CHECK STATUS&nbsp; →
          </button>

          <div class="login-divider" aria-hidden="true"></div>

          <div class="apply-row">
            <span>Need to start a new application?</span>
            <button type="button" class="btn-apply-now">
              Apply Now
            </button>
          </div>

        </div>
      </section>

      <!-- VIEW 3: APPLICATION STATUS PORTAL -->
      <section id="statusPortalView">

        <div class="portal-welcome-row">
          <div class="portal-avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <circle cx="12" cy="8" r="4"></circle>
              <path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path>
            </svg>
          </div>

          <div class="portal-welcome-text">
            <h2>Welcome, THABO KHOZA</h2>
            <p>(SA ID: 0405125800088)</p>
          </div>
        </div>

        <!-- ONE UNIFIED STATUS AND DOCUMENTS CARD -->
        <div class="status-main-card">

          <div class="status-header-box">
            <div class="status-file-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            </div>

            <div class="status-header-info">
              <span class="status-label-small">APPLICATION STATUS:</span>
              <span class="status-value-bold">SUBMITTED</span>
            </div>
          </div>

          <div class="status-meta-section">
            <div class="meta-row">
              <span class="meta-title">Ref Number:</span>
              <span class="meta-data">ATL-2026-8942</span>
            </div>

            <div class="meta-row" style="margin-top: 6px;">
              <span class="meta-title">Applying for:</span>
              <span class="meta-data">Higher Certificate in IT</span>
            </div>
          </div>

          <div class="docs-section-heading">
            Submitted Application Documents
          </div>

          <div class="docs-table-list">

            <!-- DOCUMENT 1 -->
            <div class="doc-item-row">
              <span class="doc-item-name">National ID Copy</span>

              <div class="doc-item-right">
                <span class="status-badge received">Received</span>
                <button type="button" class="btn-doc-action">View</button>
              </div>
            </div>

            <!-- DOCUMENT 2 -->
            <div class="doc-item-row">
              <span class="doc-item-name">Matric Certificate / Results</span>

              <div class="doc-item-right">
                <span class="status-badge received">Received</span>
                <button type="button" class="btn-doc-action">View</button>
              </div>
            </div>

            <!-- DOCUMENT 3 -->
            <div class="doc-item-row">
              <span class="doc-item-name">Proof of Residential Address</span>

              <div class="doc-item-right">
                <span class="status-badge not-uploaded">Not Uploaded</span>
                <button type="button" class="btn-doc-action upload">
                  Upload Document
                </button>
              </div>
            </div>

            <!-- DOCUMENT 4 -->
            <div class="doc-item-row">
              <span class="doc-item-name">Proof of Payment</span>

              <div class="doc-item-right">
                <span class="status-badge denied">Denied</span>
                <span class="status-reason">Blurry</span>
                <button type="button" class="btn-doc-action upload">
                  Upload Document
                </button>
              </div>
            </div>

          </div>
        </div>
      </section>

    </div>

    <!-- VIEW 2: RECOVER LOGIN CREDENTIALS POPUP -->
    <div class="modal-backdrop" id="forgotModal">
      <div
        class="modal-card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modalTitle"
      >

        <div class="modal-header">
          <div class="modal-title-area">
            <div class="modal-lock-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>

            <h2 id="modalTitle">Recover Login Credentials</h2>
          </div>

          <button
            type="button"
            class="modal-close-btn"
            id="closeModalBtn"
            aria-label="Close modal"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="modal-body">
          <p class="modal-instruction">
            Enter the National ID or Passport number you used during application:
          </p>

          <div class="modal-input-wrap">
            <span class="modal-input-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
              </svg>
            </span>

            <input
              type="text"
              class="modal-control"
              placeholder="Enter ID or Passport number"
              autocomplete="off"
            >
          </div>

          <button type="button" class="btn-send-details">
            SEND LOGIN DETAILS
          </button>

          <div class="modal-info-box">
            <span class="modal-info-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
            </span>

            <span>
              We will email your Application Reference Number and PIN to the email address on file.
            </span>
          </div>
        </div>

      </div>
    </div>

    <!-- FOOTER -->
    <footer class="footer">
      <div class="footer-left">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>

        <span>
          Help?
          <a href="#" style="color: var(--blue);" onclick="return false;">
            admissions@college.ac.za
          </a>
        </span>
      </div>

      <div class="footer-right">
        &copy; 2026 myAtlas
      </div>
    </footer>

  </div>

  <script>
    "use strict";

    // Page elements
    const loginView = document.getElementById("loginView");
    const statusPortalView = document.getElementById("statusPortalView");
    const topRightNav = document.getElementById("topRightNav");
    const forgotModal = document.getElementById("forgotModal");

    const checkStatusBtn = document.getElementById("checkStatusBtn");
    const forgotLink = document.getElementById("forgotLink");
    const closeModalBtn = document.getElementById("closeModalBtn");
    const logoutBtn = document.getElementById("logoutBtn");

    // Open the recovery popup.
    forgotLink.addEventListener("click", function (event) {
      event.preventDefault();
      forgotModal.classList.add("active");
      closeModalBtn.focus();
    });

    // ONLY the X button closes the recovery popup.
    closeModalBtn.addEventListener("click", function (event) {
      event.preventDefault();
      forgotModal.classList.remove("active");
      forgotLink.focus();
    });

    // CHECK STATUS opens the visual demonstration portal.
    checkStatusBtn.addEventListener("click", function () {
      forgotModal.classList.remove("active");
      loginView.style.display = "none";
      statusPortalView.classList.add("active");
      topRightNav.style.display = "block";

      window.scrollTo({
        top: 0,
        behavior: "smooth"
      });
    });

    // LOG OUT returns to the first screen.
    logoutBtn.addEventListener("click", function () {
      statusPortalView.classList.remove("active");
      topRightNav.style.display = "none";
      loginView.style.display = "flex";
      forgotModal.classList.remove("active");

      window.scrollTo({
        top: 0,
        behavior: "smooth"
      });
    });
  </script>
</body>
</html>
