rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Pre-approved validation collections for account activation
    match /pre_approved_admissions/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /pre_approved_administrators/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /pre_approved_tech_support/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Active personnel profile collections created upon successful activation
    match /admissions_staff/{id} {
      allow read, write: if request.auth != null;
    }

    match /administrators/{id} {
      allow read, write: if request.auth != null;
    }

    match /technical_support/{id} {
      allow read, write: if request.auth != null;
    }

    // Dynamic admission collections check (used by Step 1 overlap validations)
    match /{collectionName}/{cycleId} {
      allow read, write: if request.auth != null 
                        && collectionName.matches('^[0-9]{4}_.*_admissions$');
    }

    // Application Form Fields collection (used by Step 2 form customization)
    match /application_form_fields/{fieldId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Master Courses collection (used by Step 3 course selection and filtering)
    match /master_courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Mail queue collection for Firebase Trigger Email extension
    match /mail/{mailId} {
      allow create: if true;
    }
  }
}
