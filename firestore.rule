rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read for master courses catalog, write restricted
    match /master_courses/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow authenticated staff to create and manage application cycles
    match /application_cycles/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Pre-approved admin records used for validation during activation
    match /pre_approved_admins/{adminId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admin profiles collection created upon successful activation
    match /admins/{adminId} {
      allow read, write: if request.auth != null;
    }
  }
}
