rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to master courses catalog
    match /master_courses/{courseId} {
      allow read: if request.auth != null;
    }
    
    // Allow staff to manage application cycles
    match /application_cycles/{cycleId} {
      allow read, write: if request.auth != null;
    }
  }
}
