rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read for master courses catalog, write restricted
    match /master_courses/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow authenticated staff to create and manage application cycles
    match /application_cycles/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Pre-approved records used for validation during activation across all staff roles
    match /pre_approved_admins/{adminId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /pre_approved_academic_heads/{headId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /pre_approved_system_admins/{sysId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User profile collections created upon successful activation
    match /admins/{adminId} {
      allow read, write: if request.auth != null;
    }

    match /academic_heads/{headId} {
      allow read, write: if request.auth != null;
    }

    match /system_admins/{sysId} {
      allow read, write: if request.auth != null;
    }
  }
}
