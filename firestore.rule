rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read for master courses catalog, write restricted
    match /master_courses/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow authenticated staff to create and manage application cycles
    match /application_cycles/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Secure verification queries for pre-approved admins
    match /pre_approved_admins/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Rate-limiting and lockouts managed on cloud backend
    match /admin_lockouts/{deviceId} {
      allow read, write: if true;
    }

    // One-Time Passwords collection for sign-in verification
    match /admin_otps/{email} {
      allow read, write: if true;
    }
  }
}
