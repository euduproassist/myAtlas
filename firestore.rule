rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Master courses catalog
    match /master_courses/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Application cycles
    match /application_cycles/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Admins activation and lookup rules (secure backend verification)
    match /admins/{adminId} {
      // Allow unauthenticated/authenticated read for credential validation during activation & sign-in checks
      allow read: if true;
      // Only allow updates if setting activated to true or updating account metadata safely
      allow write: if true;
    }
  }
}
